# 依赖与包管理器缓存
node_modules/
.npm/
.npm-cache/
.pnpm-store/
.yarn/

# 构建、测试与覆盖率输出
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# 本地环境变量和运行日志
.env
.env.*
!.env.example
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 外部参考项目和素材不进入主项目版本库
reference/

# Codex、浏览器验证和其他以点开头的本地临时文件/目录
/.*
!/.gitignore
!/.github/
!/.github/**
!/.env.example

# 常见操作系统临时文件
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
*~
